# Copy to .env and fill in. .env is read only by the controller process; the executor's sandbox never sees these variables.

# ---- Cloud model: planner + cloud direct (only receives content certified by the privacy gate) ----
# deepseek (default) / openai / anthropic (pip install 'hermie[anthropic]') / openai-compatible (any OpenAI-style endpoint:
# OpenRouter, Moonshot, Qwen, Gemini's compatible endpoint ... set CLOUD_BASE_URL to its /v1 URL)
CLOUD_PROVIDER=deepseek
CLOUD_API_KEY=sk-...
# Only for openai-compatible (or to point openai / anthropic at a proxy)
CLOUD_BASE_URL=
# Cloud direct model and planner model. deepseek and anthropic have defaults (deepseek-v4-flash / deepseek-v4-pro,
# claude-sonnet-5 / claude-opus-5-5); openai and openai-compatible must set both
CLOUD_MODEL=deepseek-v4-flash
CLOUD_PLAN_MODEL=deepseek-v4-pro
# The pre-0.2 names DEEPSEEK_API_KEY / DEEPSEEK_MODEL / DEEPSEEK_PLAN_MODEL are still read when the CLOUD_* ones are empty

# ---- Ollama (executor + judge model, both local) ----
OLLAMA_URL=http://localhost:11434
WORKER_MODEL=qwen3.8:27b-mlx
# Use a small model as the judge: in the evals gemma4:12b matches the 27B on privacy (precision 0.97 / recall 1.00) and
# routing accuracy (39/40), at 12 s vs 18 s per routing case and 1.8x faster on the privacy eval. Re-run evals/run_evals.py before switching
JUDGE_MODEL=gemma4:12b
# Samples per judge question (votes approximate probability). The 27B model is slow; set to 1 if too slow (no confidence then, routing relies more on defaults)
JUDGE_SAMPLES=3
# Routing asks its four questions in one judge request per sample. false = one request per question (4x slower); compare with evals/run_evals.py routing before changing
JUDGE_BATCH=true
# When the judge and the executor are different models, keep the judge resident in Ollama to avoid swapping back and forth
JUDGE_KEEP_ALIVE=30m
WORKER_THINKING=false

# ---- Controlled web access: the executor reaches the web via web_fetch / web_search (run in the controller process, sandbox stays offline; URLs and queries go through the privacy gate first) ----
WEB_ENABLED=true
# Tavily search key (free tier at https://tavily.com). Empty = only web_fetch (you must supply URLs yourself)
TAVILY_API_KEY=
# Domain allowlist, comma-separated; empty = allow every public https site (private-network addresses are always refused)
WEB_ALLOWED_DOMAINS=

# ---- Mac toolchain: xcodebuild / swift / xcrun simctl / axe run through run_command inside the sandbox; the screenshot tool
#      (simulator or whole Mac display, image shown to the local vision model) runs in the controller process ----
MAC_TOOLS=true
# Allow target="mac" (whole display). Such a screenshot marks the task as having touched sensitive data and, in default
# mode, asks for approval once per session. Simulator screenshots need no approval.
SCREENSHOT_MAC=true
# Longest side of the copy shown to the model (the full-size PNG is kept under data_dir/screenshots)
SCREENSHOT_MAX_PX=1024

# ---- RouteLLM: first enable downloads about 400MB of weights from Hugging Face; discriminative power on Chinese unknown ----
ROUTELLM_ENABLED=true
ROUTELLM_THRESHOLD=0.5

# ---- Privacy ----
SENSITIVE_KEYWORDS=Project Codename A,Some Client
CONTEXT_PRIVACY_THRESHOLD=0.3

# ---- Routing thresholds (calibrate with 200-500 real requests before going live) ----
MIN_CONFIDENCE=0.6
VERIFY_THRESHOLD=0.6
# Vote share above which "needs the workspace" counts as yes (0.3 = any single yes out of three samples)
NEEDS_WORKSPACE_THRESHOLD=0.3
# hermie --calibrate proposes MIN_CONFIDENCE / ROUTELLM_THRESHOLD / NEEDS_WORKSPACE_THRESHOLD from your recorded tasks;
# --apply writes them here, and refuses below this many labelled tasks
CALIBRATE_MIN_TASKS=30

# ---- Execution environment ----
# Workspace = the directory you start in (like Claude Code); can also be set with --workspace.
# Keep it outside Desktop/Documents/Downloads to avoid macOS privacy permission prompts. The WORKSPACE env var is only the default for library use
HERMIE_DATA_DIR=~/.hermie
# default / auto (no-sandbox mode can only be started with --dangerously-no-sandbox)
RUN_MODE=default
# File names (globs) inside the workspace that the executor may not read either. Deliberately excludes .env: the project's own commands need it; the keys inside are caught at the outbound gate by the secret recognizer
SANDBOX_DENY_NAMES=id_rsa,id_ed25519,id_ecdsa,id_dsa,.netrc,*.pem,*.key,*.p12,*.pfx
# Snapshots kept per workspace (before each task + before each delegation in plan mode); older ones are pruned automatically
SNAPSHOT_KEEP=20
# Files dropped into the input box (or passed as the --json material argument) are attached as task material, read outside the sandbox and
# passed through the privacy gate with the task. PDF / Word / Excel files are converted to text first. Per-file and total
# character caps; directories attach a file tree only
ATTACH_MAX_FILE_CHARS=200000
ATTACH_MAX_TOTAL_CHARS=400000
COMMAND_TIMEOUT=120
# Seconds of silence on a prompt-like line before a command counts as waiting for input: default mode asks you in the app,
# auto / headless mode closes its stdin (a command that keeps waiting is stopped with a hint to use non-interactive flags)
COMMAND_IDLE=8
MAX_TOOL_CALLS=30
MAX_DELEGATIONS=8
# Timeouts (seconds): one Ollama request / one DeepSeek request / cap for one executor run (time waiting for your approval
# or input does not count; the UI shows the step's progress and warns at 80%). A timeout falls back or is treated as partial completion, never hangs
WORKER_TIMEOUT=600
CLOUD_TIMEOUT=300
EXECUTOR_RUN_TIMEOUT=3600

# ---- Voice (all local) ----
# Whether speech output is on at startup (toggle any time with F6 / /voice on|off). Only task done, approval needed and errors are spoken
VOICE_OUTPUT=false
# Speech voice (a name from say -v '?', e.g. Tingting, Meijia, Sinji); empty = system default
VOICE_NAME=Tingting
# Speech rate (say -r); 0 = system default
VOICE_RATE=0
# Speech recognition model (mlx-whisper; first use downloads about 1.6GB from Hugging Face, offline afterwards). If memory is tight, switch to mlx-community/whisper-small-mlx
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Cap on a single recording (seconds); stops and transcribes automatically when reached
VOICE_MAX_SECONDS=60
# Record key (press once to start, again to stop): f3-f12 or ctrl+letter; changeable in the UI with /voice key
VOICE_KEY=f5

# ---- Self-verification loop (all local) ----
# Reporting done after writing files without verifying -> bounced with a request to verify first (deterministic rule, zero cost)
VERIFY_REQUIRED=true
# Max rounds of executor fixes when the local reviewer (looks at the workspace diff and command output) fails the result; 0 = no review
VERIFY_ROUNDS=2
REVIEW_TIMEOUT=300
# Run a local recon (directories/project type/toolchain) before planning; given to the planner after the gate
RECON_ENABLED=true
# Lesson memory on/off. On: lessons are written (after a fix, or for problems raised twice) and the most relevant ones
# are recalled per step. Off: nothing is written or recalled, and the executor reads AGENT.md's "Lessons" section as is
LESSONS_ENABLED=true
# Lesson memory: lessons are also kept in ~/.hermie/lessons.jsonl, embedded locally by this Ollama model
# (ollama pull nomic-embed-text; without it lessons are matched by word overlap), and the most relevant ones are given
# to the executor before each step. Lessons of the same project always qualify; the planner never sees lessons
LESSON_EMBED_MODEL=nomic-embed-text
LESSONS_TOP_K=5
LESSONS_MIN_SIM=0.55
# Skill library: when a step with at least SKILL_MIN_TOOL_CALLS tool calls passes review (and the task touched no
# sensitive data), the local model writes a playbook to ~/.hermie/skills/. It becomes active after a second similar
# success or /skills approve; active skills similar to a step (SKILLS_MIN_SIM) are given to the executor, at most
# SKILLS_TOP_K per step; the planner never sees them. A skill used SKILL_RETIRE_USES times with a first-review pass rate
# under SKILL_RETIRE_RATE retires itself (/skills restore brings it back)
SKILLS_ENABLED=true
SKILLS_TOP_K=2
SKILLS_MIN_SIM=0.6
SKILL_MIN_TOOL_CALLS=4
# A new playbook confirms an existing skill when the playbooks are this similar, or when the steps that produced them
# are this similar and the playbooks at least loosely match
SKILL_MERGE_SIM=0.8
SKILL_RETIRE_USES=5
SKILL_RETIRE_RATE=0.3
